<%- include('partials/head', { title: 'Search Member' }) %>

<div>
  <p class="eyebrow">Member Services</p>
  <h1>Look Up a Member</h1>
  <p class="page-description">Search by member ID to view account details and savings balance.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="banner banner-error" role="alert">
    <span class="banner-icon" aria-hidden="true">&#9888;</span>
    <span><%= error %></span>
  </div>
<% } %>

<div class="card">
  <form method="post" action="/members/search">
    <div class="field">
      <label for="memberId">Member ID</label>
      <input type="text" id="memberId" name="memberId" required autofocus placeholder="e.g. 1001" />
      <p class="field-hint">Enter the member's unique ID exactly as it appears on file.</p>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Search</button>
  </form>
</div>

<div class="empty-state">
  <div class="empty-state-icon" aria-hidden="true">&#128269;</div>
  <p>No member selected yet — search above to get started.</p>
</div>

<%- include('partials/foot') %>
