# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- SQLite (target application database — Phase 3) ---
DB_PATH=./data/app.db

# --- Anthropic Claude API (discovery agent — Phase 6) ---
# Not required for Phase 2 foundation; the discovery agent does not exist yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Safety / policy (Phase 8) ---
# Comma-separated list of allowed base URLs/routes for the computer-use layer.
ALLOWLIST_BASE_URL=http://localhost:3000

# --- Evidence / logging (Phase 8) ---
EVIDENCE_DIR=./evidence
