{
  "schemaVersion": "1.0",
  "id": "open-sub-account",
  "name": "Open Sub-Account",
  "description": "Opens a new sub-account (savings or checking) for a Credit Union Teller Console member and reaches the confirmation screen. Does not perform any real financial transaction. Risky/mutating.",
  "version": "1.0.0",
  "createdAt": "2026-08-16T00:00:00.000Z",
  "riskLevel": "risky",
  "target": {
    "appId": "credit-union-teller-console",
    "baseUrl": "http://localhost:3000",
    "surfaceType": "web"
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "The member's unique ID, exactly as it appears on file.",
      "example": "1002"
    },
    {
      "name": "accountType",
      "type": "string",
      "required": true,
      "description": "Either \"sub_savings\" or \"sub_checking\".",
      "example": "sub_savings"
    },
    {
      "name": "nickname",
      "type": "string",
      "required": true,
      "description": "A short label for the new account, 2-40 characters.",
      "example": "Vacation Fund"
    },
    {
      "name": "initialDeposit",
      "type": "string",
      "required": true,
      "description": "Opening deposit as a decimal dollar amount string; must be at least $25.00.",
      "example": "150.00"
    }
  ],
  "outputs": [],
  "steps": [
    {
      "stepId": 1,
      "action": "navigate",
      "description": "Open the Credit Union Teller Console search page.",
      "url": "/"
    },
    {
      "stepId": 2,
      "action": "type",
      "description": "Enter the member ID into the search field.",
      "target": {
        "description": "Member ID field",
        "strategies": [
          {
            "type": "role",
            "role": "textbox",
            "name": "Member ID"
          },
          {
            "type": "label",
            "text": "Member ID"
          }
        ]
      },
      "value": "{{memberId}}"
    },
    {
      "stepId": 3,
      "action": "click",
      "description": "Submit the member search.",
      "target": {
        "description": "Search button",
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "Search"
          }
        ]
      }
    },
    {
      "stepId": 4,
      "action": "click",
      "description": "Open the sub-account form for this member.",
      "target": {
        "description": "Open Sub-Account link",
        "strategies": [
          {
            "type": "role",
            "role": "link",
            "name": "Open Sub-Account"
          }
        ]
      }
    },
    {
      "stepId": 5,
      "action": "type",
      "description": "Select the sub-account type.",
      "target": {
        "description": "Account Type field",
        "strategies": [
          {
            "type": "role",
            "role": "combobox",
            "name": "Account Type"
          },
          {
            "type": "label",
            "text": "Account Type"
          }
        ]
      },
      "value": "{{accountType}}"
    },
    {
      "stepId": 6,
      "action": "type",
      "description": "Enter the account nickname.",
      "target": {
        "description": "Account Nickname field",
        "strategies": [
          {
            "type": "role",
            "role": "textbox",
            "name": "Account Nickname"
          },
          {
            "type": "label",
            "text": "Account Nickname"
          }
        ]
      },
      "value": "{{nickname}}"
    },
    {
      "stepId": 7,
      "action": "type",
      "description": "Enter the initial deposit amount.",
      "target": {
        "description": "Initial Deposit field",
        "strategies": [
          {
            "type": "role",
            "role": "textbox",
            "name": "Initial Deposit (USD)"
          },
          {
            "type": "label",
            "text": "Initial Deposit (USD)"
          }
        ]
      },
      "value": "{{initialDeposit}}"
    },
    {
      "stepId": 8,
      "action": "click",
      "description": "Submit the sub-account form.",
      "target": {
        "description": "Open Sub-Account submit button",
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "Open Sub-Account"
          }
        ]
      }
    }
  ],
  "checkpoint": {
    "description": "The sub-account was created and the confirmation screen was reached.",
    "all": [
      {
        "type": "urlMatches",
        "pattern": "/confirmation"
      },
      {
        "type": "textPresent",
        "text": "Sub-account opened successfully."
      }
    ]
  },
  "businessOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with the given ID.",
      "when": [
        {
          "type": "textPresent",
          "text": "Member Not Found"
        }
      ]
    },
    {
      "code": "VALIDATION_FAILED",
      "description": "The submitted form failed server-side validation (invalid account type, nickname, or deposit amount).",
      "when": [
        {
          "type": "textPresent",
          "text": "Please fix the errors below."
        }
      ]
    },
    {
      "code": "ACCOUNT_OPENING_BLOCKED",
      "description": "The member's account is restricted; sub-account opening is not permitted.",
      "when": [
        {
          "type": "textPresent",
          "text": "Action Not Permitted"
        }
      ]
    },
    {
      "code": "LARGE_DEPOSIT_CONFIRMATION_REQUIRED",
      "description": "The requested initial deposit is at or above the large-deposit threshold ($10,000.00) and requires an additional confirmation step not covered by this recorded flow.",
      "when": [
        {
          "type": "textPresent",
          "text": "Confirm Large Deposit"
        }
      ]
    }
  ]
}