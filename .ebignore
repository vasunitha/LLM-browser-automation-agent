# Elastic Beanstalk deployment bundle exclusions.
# dist/ is intentionally INCLUDED (not excluded) — EB's install phase runs
# npm --omit=dev install, so devDependencies (typescript, tsx) aren't
# reliably available to build it on the instance. The already-built dist/
# is shipped as part of the source bundle instead.
node_modules/

# Environment / secrets — set via EB environment properties instead, never committed
.env
.env.local

# Local runtime data — the instance filesystem is ephemeral anyway; see
# .platform/hooks/postdeploy/01_seed_db.sh for how the DB gets (re)seeded
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Playwright / test output — not part of the running application
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
